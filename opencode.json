{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch --show-current*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git worktree list*": "allow",
      "bash scripts/check.sh*": "allow",
      "scripts/check.sh*": "allow",
      "DATABASE_URL=* bash scripts/check.sh*": "allow",
      "npm run lint*": "allow",
      "npm test*": "allow",
      "npx tsc --noEmit*": "allow",
      "git push *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "npm install*": "allow",
      "npm i *": "allow",
      "vercel deploy*": "allow",
      "vercel": "allow",
      "npx prisma*": "ask",
      "npm run db:*": "ask",
      "npm run seed*": "ask",
      "npm run dev*": "ask",
      "npx next dev*": "ask",
      "npm start*": "ask",
      "npm run build*": "ask",
      "npm run ingest*": "ask",
      "npx tsx scripts/*": "ask",
      "npx tsx prisma/*": "ask",
      "vercel --prod*": "deny",
      "vercel deploy --prod*": "deny",
      "vercel promote*": "deny",
      "git push origin main*": "deny",
      "git push * main": "deny",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git branch -D*": "deny",
      "cat *.env*": "deny",
      "printenv*": "deny",
      "env": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "allow"
  }
}
