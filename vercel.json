{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/fact-check-preview": false
    }
  },
  "functions": {
    "app/api/cron/route.ts": {
      "maxDuration": 300
    },
    "app/api/ingest/route.ts": {
      "maxDuration": 300
    },
    "app/api/images/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    }
  ]
}
