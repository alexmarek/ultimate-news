{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/cron/route.ts": {
      "maxDuration": 300
    },
    "app/api/ingest/route.ts": {
      "maxDuration": 300
    },
    "app/api/images/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    }
  ]
}
