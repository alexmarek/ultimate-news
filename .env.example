# Copy this to .env and fill in your values
#
# Use Neon (https://neon.tech) for a free PostgreSQL database.
# For local dev with Docker:
#   docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=ultimatenews postgres

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ultimatenews"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ultimatenews"

# Optional
ANTHROPIC_API_KEY="sk-ant-..."
VOYAGE_API_KEY="pa-..."

INGEST_CRON_SECRET="generate-a-long-random-string-here"
CRON_SECRET="generate-a-long-random-string-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"