# Copy this to .env and fill in your values
#
# Use Neon (https://neon.tech) for a free PostgreSQL database.
# For local dev with Docker:
#   docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=ultimatenews postgres

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ultimatenews"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ultimatenews"

# Optional
ANTHROPIC_API_KEY="sk-ant-..."
VOYAGE_API_KEY="pa-..."

INGEST_CRON_SECRET="generate-a-long-random-string-here"
CRON_SECRET="generate-a-long-random-string-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fact checking (server-side only)
FACT_CHECK_ENABLED="false"
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
FACT_CHECK_OWNER_GOOGLE_SUBJECT=""
OPENROUTER_API_KEY=""
FACT_CHECK_MODEL="z-ai/glm-5.3"
FACT_CHECK_MAX_CLAIMS="2"
FACT_CHECK_MAX_SEARCHES="16"
FACT_CHECK_MAX_COST_USD="1"
# JSON with verified per-request OpenRouter search bounds for a custom model.
# Fields: maxModelCalls, maxInputTokensPerCall, maxOutputTokensPerCall,
# maxSearchCalls, maxSearchFeeUsd. GLM 5.3 has built-in bounds.
FACT_CHECK_SEARCH_LIMITS_JSON=""
