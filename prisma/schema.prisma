// Simplified schema for local development with SQLite
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// For local SQLite development, change provider to "sqlite"
// and url to "file:./dev.db"

model Source {
  id                    String   @id
  name                  String
  url                   String
  feedUrl               String?
  ingestStrategy        String
  lang                  String
  tier                  String
  editorialIndependence String
  isWireService         Boolean  @default(false)
  contentKind           String   @default("news")
  weight                Float    @default(0.75)
  isActive              Boolean  @default(true)
  lastFetchedAt         DateTime?
  lastErrorAt           DateTime?
  lastError             String?
  consecutiveErrors     Int      @default(0)
  articles              Article[]
}

model Article {
  id              String   @id
  source          Source   @relation(fields: [sourceId], references: [id])
  sourceId        String
  canonicalUrl    String   @unique
  originalUrl     String
  title           String
  titleEn         String?
  excerpt         String
  content         String?
  publishedAt     DateTime
  fetchedAt       DateTime @default(now())
  author          String?
  lang            String
  summary         String?
  /// 1-5: how much this story matters to the reader (lib/config/reader.ts); null for fallback summaries.
  importance      Int?
  /// One sentence on how the story concretely affects the reader (AI inference, labelled as such in the UI).
  forYou          String?
  /// True when only a teaser/snippet was available, so the summary is short by necessity.
  fromTeaser      Boolean  @default(false)
  areas           String
  primaryArea     String
  areaConfidences String?
  topics          String
  entities        String
  imageUrl        String?
  imageAlt        String?
  isPaywalled     Boolean  @default(false)
  isWireOrigin    Boolean  @default(false)
  lowConfidenceTag Boolean @default(false)
  isInDailyFeed   Boolean @default(false)
  embedding       String?
  syndicatedFrom  String?
  cluster         Cluster? @relation(fields: [clusterId], references: [id])
  clusterId       String?
  savedBy         ArticleSaved[]
  readBy          ArticleRead[]
}

model Cluster {
  id                      String   @id @default(cuid())
  representativeArticleId String
  totalSourceCount        Int
  independentSourceCount  Int
  uniqueWireOriginCount   Int      @default(0)
  hasIndependentVoice     Boolean
  corroborationScore      Float
  earliestPublishedAt     DateTime
  latestPublishedAt       DateTime
  areas                   String
  primaryArea             String
  sourcesAttributed       String
  combinedSummary         String?
  articles                Article[]
}

model ArticleRead {
  userId    String
  articleId String
  article   Article    @relation(fields: [articleId], references: [id])
  readAt    DateTime   @default(now())

  @@id([userId, articleId])
}

model ArticleSaved {
  userId    String
  articleId String
  article   Article    @relation(fields: [articleId], references: [id])
  savedAt   DateTime   @default(now())

  @@id([userId, articleId])
}
/// Latest market data shown on the homepage ("etfs", "petrol"), refreshed by the daily cron.
model MarketSnapshot {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/// Curated-category (Travel) articles already judged by the daily pick, featured or passed over,
/// so none is shown twice or re-rated. Kept a little longer than the category's age window.
model ConsideredArticle {
  /// Article id (hash of the canonical URL).
  id           String   @id
  /// URL as the feed or listing gave it: matched before the per-source limit is applied.
  url          String
  area         String
  /// Claude's 1-5 inspiration rating.
  score        Int?
  featured     Boolean
  consideredAt DateTime @default(now())

  @@index([url])
}

// Fact checks are independent of the feed, which is refreshed by ingestion.
model FactCheckUser {
  id            String   @id @default(cuid())
  email         String   @unique
  googleSubject String?  @unique
  role          String   @default("editor")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FactCheckArticle {
  id                String            @id @default(cuid())
  canonicalUrl      String            @unique
  publishedReportId String?           @unique
  activeJobId       String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  reports           FactCheckReport[] @relation("FactCheckArticleReports")
  publishedReport   FactCheckReport?  @relation("PublishedFactCheck", fields: [publishedReportId], references: [id], onDelete: SetNull)
}

model FactCheckReport {
  id                  String            @id @default(cuid())
  articleId           String
  article             FactCheckArticle  @relation("FactCheckArticleReports", fields: [articleId], references: [id], onDelete: Cascade)
  publishedFor        FactCheckArticle? @relation("PublishedFactCheck")
  version             Int
  status              String            @default("queued")
  title               String?
  publisher           String?
  author              String?
  articlePublishedAt  DateTime?
  language            String?
  score               Float?
  verdict             String?
  confidence          String?
  executiveSummary    String?
  supportedFindings   Json?
  unsupportedFindings Json?
  missingContext      Json?
  accurateFormulation String?
  verifiedAt          DateTime?
  publishedAt         DateTime?
  modelId             String
  methodologyVersion  String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  claims              FactCheckClaim[]
  evidence            FactCheckEvidence[]
  jobs                FactCheckJob[]

  @@unique([articleId, version])
  @@index([status, verifiedAt])
}

model FactCheckClaim {
  id          String              @id @default(cuid())
  reportId    String
  report      FactCheckReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  statement   String
  importance  String
  central     Boolean
  score       Float?
  verdict     String
  confidence  String
  explanation String
  evidence    FactCheckEvidence[]
  checkpoints FactCheckClaimCheckpoint[]

  @@index([reportId])
}

model FactCheckEvidence {
  id          String          @id @default(cuid())
  reportId    String
  report      FactCheckReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  claimId     String
  claim       FactCheckClaim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  title       String
  publisher   String?
  url         String
  publishedAt DateTime?
  retrievedAt DateTime
  sourceType  String
  provenance  String?
  excerpt     String
  relationship String

  @@index([reportId, claimId])
}

model FactCheckJob {
  id             String          @id @default(cuid())
  reportId       String
  report         FactCheckReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workflowId     String?         @unique
  status         String          @default("queued")
  errorCategory  String?
  attempts       Int             @default(0)
  searchCount    Int             @default(0)
  estimatedCost  Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  checkpoints    FactCheckClaimCheckpoint[]
  identificationCheckpoint FactCheckIdentificationCheckpoint?
  evaluationCheckpoint FactCheckEvaluationCheckpoint?

  @@index([reportId, status])
}

model FactCheckEvaluationCheckpoint {
  jobId          String   @id
  job            FactCheckJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  state          String   @default("pending")
  leaseToken     String?
  leaseExpiresAt DateTime?
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FactCheckIdentificationCheckpoint {
  jobId          String   @id
  job            FactCheckJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  state          String   @default("pending")
  leaseToken     String?
  leaseExpiresAt DateTime?
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FactCheckClaimCheckpoint {
  jobId          String
  job            FactCheckJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  claimId        String
  claim          FactCheckClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  state          String         @default("pending")
  leaseToken     String?
  leaseExpiresAt DateTime?
  attempts       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@id([jobId, claimId])
}
